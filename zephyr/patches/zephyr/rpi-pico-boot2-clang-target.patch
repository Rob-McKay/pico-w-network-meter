diff --git a/modules/hal_rpi_pico/CMakeLists.txt b/modules/hal_rpi_pico/CMakeLists.txt
index 0c6962a78..e1cc58ad4 100644
--- a/modules/hal_rpi_pico/CMakeLists.txt
+++ b/modules/hal_rpi_pico/CMakeLists.txt
@@ -25,6 +25,16 @@ if(CONFIG_HAS_RPI_PICO)
     set(rp2_bootloader_prefix ${CMAKE_BINARY_DIR}/bootloader)
     set(rp2_bootloader_asm ${rp2_bootloader_prefix}/boot_stage2.S)
 
+    # A GCC cross compiler implies its target, but clang needs the triple
+    # (the LLVM toolchain sets it), or it assembles for the host.
+    set(rp2_bootloader_target_args)
+    foreach(lang C ASM)
+      if(DEFINED CMAKE_${lang}_COMPILER_TARGET)
+        list(APPEND rp2_bootloader_target_args
+          -DCMAKE_${lang}_COMPILER_TARGET=${CMAKE_${lang}_COMPILER_TARGET})
+      endif()
+    endforeach()
+
     ExternalProject_Add(
       second_stage_bootloader
       SOURCE_DIR ${CMAKE_CURRENT_LIST_DIR}/bootloader
@@ -39,6 +49,7 @@ if(CONFIG_HAS_RPI_PICO)
         -DPYTHON_EXECUTABLE=${Python3_EXECUTABLE}
         -DRP2_BOOTLOADER_BYPRODUCT=${rp2_bootloader_asm}
         -DCONFIG_PICOLIBC=${CONFIG_PICOLIBC}
+        ${rp2_bootloader_target_args}
       INSTALL_COMMAND "" # No installation needed
       BUILD_BYPRODUCTS ${rp2_bootloader_asm}
       BUILD_ALWAYS TRUE
