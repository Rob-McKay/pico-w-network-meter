diff --git a/drivers/wifi/esp32/src/esp_wifi_drv.c b/drivers/wifi/esp32/src/esp_wifi_drv.c
index 708816506..fd43ba446 100644
--- a/drivers/wifi/esp32/src/esp_wifi_drv.c
+++ b/drivers/wifi/esp32/src/esp_wifi_drv.c
@@ -507,6 +507,34 @@ static void scan_done_handler(const wifi_event_sta_scan_done_t *evt)
 		res.channel = ap_record.primary;
 		res.band = wifi_utils_chan_to_band(res.channel);
 
+		switch (ap_record.bandwidth) {
+		case WIFI_BW20:
+			res.bandwidth = WIFI_FREQ_BANDWIDTH_20MHZ;
+			res.center_channel = ap_record.primary;
+			break;
+		case WIFI_BW40:
+			/* The secondary 20 MHz channel is 4 channel numbers above or below */
+			res.bandwidth = WIFI_FREQ_BANDWIDTH_40MHZ;
+			if (ap_record.second == WIFI_SECOND_CHAN_ABOVE) {
+				res.center_channel = ap_record.primary + 2;
+			} else if (ap_record.second == WIFI_SECOND_CHAN_BELOW) {
+				res.center_channel = ap_record.primary - 2;
+			}
+			break;
+		case WIFI_BW80:
+		case WIFI_BW80_BW80:
+			/* For 80+80 MHz, the lower 80 MHz segment */
+			res.bandwidth = WIFI_FREQ_BANDWIDTH_80MHZ;
+			res.center_channel = ap_record.vht_ch_freq1;
+			break;
+		case WIFI_BW160:
+			res.bandwidth = WIFI_FREQ_BANDWIDTH_160MHZ;
+			res.center_channel = ap_record.vht_ch_freq1;
+			break;
+		default:
+			break;
+		}
+
 		memcpy(res.mac, ap_record.bssid, WIFI_MAC_ADDR_LEN);
 		res.mac_length = WIFI_MAC_ADDR_LEN;
 
