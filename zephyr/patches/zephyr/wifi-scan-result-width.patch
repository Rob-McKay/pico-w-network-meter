 	WIFI_FREQ_BANDWIDTH_4MHZ,
 	/** 8 MHz. (Sub-1GHz channels only) */
 	WIFI_FREQ_BANDWIDTH_8MHZ,
+	/** 160 MHz. */
+	WIFI_FREQ_BANDWIDTH_160MHZ,
 
 	/** Number of frequency bandwidths available. */
 	__WIFI_FREQ_BANDWIDTH_AFTER_LAST,
diff --git a/include/zephyr/net/wifi_mgmt.h b/include/zephyr/net/wifi_mgmt.h
index d038cf938..57cb88fc6 100644
--- a/include/zephyr/net/wifi_mgmt.h
+++ b/include/zephyr/net/wifi_mgmt.h
@@ -685,6 +685,12 @@ struct wifi_scan_result {
 	uint8_t mac[WIFI_MAC_ADDR_LEN];
 	/** BSSID length */
 	uint8_t mac_length;
+	/** Channel width, enum wifi_frequency_bandwidths; 0 if the driver doesn't say */
+	uint8_t bandwidth;
+	/** Centre channel of the whole width (the primary channel for 20 MHz); 0 if the
+	 *  driver doesn't say
+	 */
+	uint8_t center_channel;
 };
 
