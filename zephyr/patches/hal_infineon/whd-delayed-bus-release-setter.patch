+void whd_bus_sdio_wlan_set_delayed_bus_powersave_milliseconds(whd_driver_t whd_driver, uint32_t time_ms)
+{
+    struct whd_bus_common_info *bus_common;
+    uint32_t flags;
+
+    if ( (whd_driver == NULL) || (whd_driver->bus_common_info == NULL) )
+    {
+        return;
+    }
+    bus_common = whd_driver->bus_common_info;
+
+    /* Taken up by whd_bus_handle_delayed_release() the next time the WHD thread waits */
+    WHD_SAVE_INTERRUPTS(flags);
+    bus_common->delayed_bus_release_timeout_ms_request = time_ms;
+    WHD_RESTORE_INTERRUPTS(flags);
+}
