# Options for the Raspberry Pi Pico W target only.

config METER_DEBUG_WIFI_IRQ
	bool "After a failed scan, log the Wi-Fi library's state"
	depends on WIFI_AIROC
	help
	  For finding why scans stop working after a few hours: when a
	  scan fails or times out, logs the Wi-Fi chip's interrupt line
	  (GPIO 24) and the WHD library's credits, queue, bus and thread,
	  then wakes the WHD thread to read from the chip and logs them
	  again (src/target/pico/wifi_debug.c). Reads WHD internals; for
	  debug builds only.

config METER_USB_CONSOLE_FLOW
	bool "Console flow control that follows DTR"
	default y
	depends on USBD_CDC_ACM_CLASS
	help
	  The Pico's console is a CDC-ACM port on its own USB socket
	  (boards/rpi_pico_rp2040_w.conf and .overlay). Its driver drops
	  output it can't buffer at once, or with flow control waits for
	  ever when no host is reading. This turns flow control on only
	  while a terminal has the port open, following DTR
	  (src/target/pico/usb_console.c).
