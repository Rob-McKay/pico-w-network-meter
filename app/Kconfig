menu "Network meter"

config METER_SCAN_INTERVAL_S
	int "Seconds between scans"
	default 10
	range 1 3600
	help
	  Time from the end of one scan to the start of the next. Button X
	  starts a scan at once.

config METER_SCAN_TIMEOUT_S
	int "Longest wait for a scan, seconds"
	default 15
	range 1 120
	help
	  A scan of every 2.4 GHz channel takes a few seconds. One that has not
	  finished by then is shown with what it heard so far.

config METER_SCAN_PASSIVE
	bool "Passive scans"
	default y
	help
	  Listen on each channel for beacons instead of sending probe
	  requests. A passive scan stays long enough on each channel to hear
	  every network's beacons (sent about every 100 ms), so it finds
	  weak and distant networks that an active scan, with its short
	  stay on each channel, misses. A sweep takes a second or two.

config METER_SCAN_DWELL_PASSIVE_MS
	int "Time on each channel in a passive scan, ms"
	default 0
	range 0 1500
	help
	  How long a passive scan listens on each channel (Zephyr's
	  wifi_scan_params.dwell_time_passive). 0 leaves it to the Wi-Fi
	  driver. Beacons come about every 102 ms, so 120-150 ms hears
	  every network once a sweep; longer makes a sweep slower. Drivers
	  that ignore the setting scan as before.

config METER_SCAN_DWELL_ACTIVE_MS
	int "Time on each channel in an active scan, ms"
	default 0
	range 0 1500
	help
	  How long an active scan (METER_SCAN_PASSIVE=n) stays on each
	  channel (wifi_scan_params.dwell_time_active). 0 leaves it to the
	  Wi-Fi driver.

config METER_BAND_5G
	bool "Keep 5 GHz networks"
	help
	  Keep the 5 GHz networks a scan hears, for a Wi-Fi chip that has the
	  band: the XIAO ESP32-C5's board .conf turns it on; the Pico W's
	  CYW43439 is 2.4 GHz only. Without it they count as "other". So far
	  the console reports them, with the best 80 MHz block; the screens
	  show 2.4 GHz only.

config METER_RECOMMEND_5G_132
	bool "Recommend the 5 GHz block 132-144"
	depends on METER_BAND_5G
	help
	  Consider the 80 MHz block 132-144 for the 5 GHz recommendation. The
	  US allows it; Europe and the UK stop at 140, so a router there
	  can't use the block at 80 MHz. 36-48, 52-64, 100-112 and 116-128 are
	  always considered.

config METER_RECOMMEND_5G_UPPER
	bool "Recommend the 5 GHz block 149-161"
	depends on METER_BAND_5G
	help
	  Consider the 80 MHz block 149-161 for the 5 GHz recommendation. The
	  US allows it at full power; in the UK it is short-range-device
	  spectrum (indoors, low power), which many routers don't offer.
	  Networks on it are counted either way.

config METER_WIFI_COUNTRY
	string "Wi-Fi country, ISO 3166 alpha-2"
	default ""
	help
	  The regulatory domain the meter asks the Wi-Fi driver for at
	  start-up (NET_REQUEST_WIFI_REG_DOMAIN), which decides the channels
	  it scans: for example "GB", "US", "DE", or "00" for the world-safe
	  set. Empty leaves it to the driver: on the Pico W, the AIROC
	  driver has no regulatory-domain request and takes its country
	  from CONFIG_WHD_WIFI_COUNTRY instead.

config METER_WIFI_REG_DOMAIN
	bool
	default y if METER_WIFI_COUNTRY != ""
	help
	  Set when METER_WIFI_COUNTRY names a country: builds
	  src/wifi_country.c.

config METER_RESET_CAUSE_HWINFO
	bool "Record the hardware's reset cause with each start"
	select HWINFO
	help
	  Reads the reset cause from the hardware (hwinfo_get_reset_cause())
	  and keeps it in each start's record, so the events screen can
	  name what the restart note can't tell apart: the reset button, a
	  hardware watchdog, a brown-out, a CPU fault. Only for boards whose
	  hwinfo driver reports it reliably: the RP2040's keeps the last
	  power-on until the next one, so the Pico W leaves this off.

config METER_RETRY_S
	int "Seconds before retrying a scan that heard nothing"
	default 2
	range 1 3600
	help
	  A scan that fails, or hears no networks at all, is retried after
	  this long instead of CONFIG_METER_SCAN_INTERVAL_S.

config METER_RECOVER_AFTER
	int "Failed scans in a row before the meter restarts"
	default 5
	range 0 1000
	help
	  A Wi-Fi driver can stop working for good: the Pico W's AIROC
	  driver runs out of packet buffers, after which no scan can start. After this many failed scans in a row
	  (about 10 seconds at CONFIG_METER_RETRY_S = 2), the meter
	  restarts to recover. 0 never restarts.

config METER_FADE_START_S
	int "Seconds a network stays at full brightness"
	default 60
	range 0 3600
	help
	  Time after a network was last heard before it starts to fade on
	  the screen.

config METER_FADE_END_S
	int "Seconds until a network has faded out"
	default 120
	range 1 3600
	help
	  Time after a network was last heard by which it has faded and is
	  forgotten. Must be more than CONFIG_METER_FADE_START_S.

config METER_FADE_MIN_PERCENT
	int "Brightness a network fades to before it goes, percent"
	default 40
	range 0 100
	help
	  A fading network dims towards this, and stays visible, until
	  CONFIG_METER_FADE_END_S, when it goes. 0 fades it to black.

config METER_REDRAW_MS
	int "Milliseconds between screen updates"
	default 500
	range 50 10000
	help
	  How often the screen is checked for changes (new results or
	  fading), and redrawn if anything changed.

config METER_LED_BRIGHTNESS
	int "RGB LED brightness, percent"
	default 2
	range 1 100
	help
	  The status RGB LED is dimmed with PWM (the Display Pack's is very
	  bright at full power). Zephyr's LED API
	  sets brightness in whole percent, so 1 is the dimmest it can be
	  short of off.

config METER_SCAN_STACK_SIZE
	int "Scan thread stack size"
	default 2048

config METER_SCAN_PRIORITY
	int "Scan thread priority"
	default 5

# The event log's options, shared with tests/event_log.
rsource "Kconfig.event_log"

# Options that only one target has (src/target/<target>/Kconfig).
rsource "src/target/*/Kconfig"

module = METER
module-str = Network meter
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
