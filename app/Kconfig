menu "Network meter"

config METER_SCAN_INTERVAL_S
	int "Seconds between scans"
	default 10
	range 1 3600
	help
	  Time from the end of one scan to the start of the next. Button X
	  starts a scan at once.

config METER_SCAN_TIMEOUT_S
	int "Longest wait for a scan, seconds"
	default 15
	range 1 120
	help
	  A scan of every 2.4 GHz channel takes a few seconds. One that has not
	  finished by then is shown with what it heard so far.

config METER_SCAN_PASSIVE
	bool "Passive scans"
	default y
	help
	  Listen on each channel for beacons instead of sending probe
	  requests. A passive scan stays long enough on each channel to hear
	  every network's beacons (sent about every 100 ms), so it finds
	  weak and distant networks that an active scan, with its short
	  stay on each channel, misses. A sweep takes a second or two.

config METER_RETRY_S
	int "Seconds before retrying a scan that heard nothing"
	default 2
	range 1 3600
	help
	  A scan that fails, or hears no networks at all, is retried after
	  this long instead of CONFIG_METER_SCAN_INTERVAL_S.

config METER_RECOVER_AFTER
	int "Failed scans in a row before the meter restarts"
	default 5
	range 0 1000
	help
	  The Wi-Fi driver can run out of packet buffers for good, after
	  which no scan can start. After this many failed scans in a row
	  (about 10 seconds at CONFIG_METER_RETRY_S = 2), the meter
	  restarts to recover. 0 never restarts.

config METER_FADE_START_S
	int "Seconds a network stays at full brightness"
	default 15
	range 0 3600
	help
	  Time after a network was last heard before it starts to fade on
	  the screen.

config METER_FADE_END_S
	int "Seconds until a network has faded out"
	default 30
	range 1 3600
	help
	  Time after a network was last heard by which it has faded to black
	  and is forgotten. Must be more than CONFIG_METER_FADE_START_S.

config METER_REDRAW_MS
	int "Milliseconds between screen updates"
	default 500
	range 50 10000
	help
	  How often the screen is checked for changes (new results or
	  fading), and redrawn if anything changed.

config METER_LED_BRIGHTNESS
	int "RGB LED brightness, percent"
	default 5
	range 1 100
	help
	  The Display Pack's RGB LED is dimmed with PWM.

config METER_SCAN_STACK_SIZE
	int "Scan thread stack size"
	default 2048

config METER_SCAN_PRIORITY
	int "Scan thread priority"
	default 5

module = METER
module-str = Network meter
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
